# Anthropic (AI engine — all 19 agent brains)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — CrewOS's own database (workspaces/agents/conversations/tasks/integrations)
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clerk — multi-tenant authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Stripe — subscription billing (Section 12 pricing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One recurring monthly Price ID per plan, created in the Stripe dashboard.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_AGENCY=price_...

# Credential encryption — encrypts every client integration credential
# (their Vercel token, Resend key, Twilio SID, Apollo key, etc.) before it's
# stored in the `integrations` table. Generate with:
#   openssl rand -base64 32
# Guard this like any other production secret. Losing it means every stored
# integration credential becomes permanently undecryptable — back it up
# somewhere safe (a password manager or secrets vault), not just in Vercel.
CREDENTIALS_ENCRYPTION_KEY=

# Note: per-CLIENT integration credentials (their Vercel token, Resend key,
# Twilio SID, Apollo key, etc.) are NOT env vars themselves — they live
# encrypted in the `integrations` table (encrypted using the key above),
# one row per workspace per provider, entered through the Integrations page.
# lib/integrations.ts is the only module that reads/writes that column.
